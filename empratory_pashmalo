<!DOCTYPE html> <html lang="fa" dir="rtl"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1"> <title>امپراتوری پشمالو 🐑</title> <style> body { margin: 0; padding: 15px; font-family: sans-serif; text-align: center; background: linear-gradient(#dff7d5, #a8d88f); color: #244b28; } .game { max-width: 600px; margin: auto; padding: 18px; background: #f8fff4; border-radius: 22px; box-shadow: 0 5px 18px #0002; } h1 { color: #34783b; } #field { min-height: 220px; padding: 12px; margin: 18px 0; background: #83c96b; border: 4px solid #559844; border-radius: 18px; display: flex; flex-wrap: wrap; justify-content: center; align-content: flex-start; gap: 8px; } .sheep-card { width: 85px; padding: 5px; border-radius: 12px; background: #ffffffaa; cursor: pointer; border: 2px solid transparent; } .sheep-card.selected { border-color: #ff9800; background: #fff0bd; transform: scale(1.05); } .sheep-image { width: 60px; height: 60px; object-fit: contain; } .sheep-emoji { font-size: 48px; height: 60px; } .level { font-size: 12px; font-weight: bold; } button { padding: 13px 18px; margin: 5px; border: none; border-radius: 12px; background: #ffcf50; color: #382d12; font-size: 16px; font-weight: bold; cursor: pointer; } #hitButton { width: 100%; background: #348b43; color: white; font-size: 20px; } #mergeButton { background: #9164d8; color: white; } #message { min-height: 24px; } </style> </head> <body> <div class="game"> <h1>🐑 امپراتوری پشمالو 👑</h1> <p>مزرعه‌ات رو بساز، گوسفندها رو ترکیب کن و امپراتوری بساز!</p> <h2>تعداد گوسفندها: <span id="count">0</span></h2> <h3>قدرت کل: <span id="power">0</span></h3> <div id="field"></div> <button id="hitButton">👊 ضربه به زمین!</button> <button id="mergeButton">✨ ترکیب دو گوسفند</button> <button id="resetButton">🔄 شروع دوباره</button> <p id="message">برای گرفتن گوسفند جدید ضربه بزن!</p> <p>برای ترکیب، دو گوسفند هم‌سطح رو انتخاب کن.</p> </div> <script> // نام فایل عکس گوسفند؛ باید کنار index.html باشد. const SHEEP_IMAGE = "babai.pnj.png"; // سطح‌های گوسفندها const levels = [ { name: "معمولی", emoji: "🐑", power: 1 }, { name: "طلایی", emoji: "🐏", power: 3 }, { name: "سلطنتی", emoji: "👑", power: 10 }, { name: "آتشین", emoji: "🔥", power: 30 }, { name: "الماسی", emoji: "💎", power: 100 }, { name: "کهکشانی", emoji: "🌌", power: 300 } ]; const countText = document.getElementById("count"); const powerText = document.getElementById("power"); const field = document.getElementById("field"); const message = document.getElementById("message"); // اطلاعات بازی در گوشی ذخیره می‌شود. let sheep = []; try { sheep = JSON.parse(localStorage.getItem("fluffyEmpireSheep")) || []; if (!Array.isArray(sheep)) sheep = []; } catch { sheep = []; } let selected = []; function saveGame() { localStorage.setItem("fluffyEmpireSheep", JSON.stringify(sheep)); } function getPower() { return sheep.reduce((sum, s) => { return sum + levels[s.level].power; }, 0); } function drawGame() { field.innerHTML = ""; selected = selected.filter(id => sheep.some(s => s.id === id)); // برای جلوگیری از سنگین شدن صفحه، حداکثر 150 کارت نشان داده می‌شود. const visibleSheep = sheep.slice(0, 150); visibleSheep.forEach(s => { const card = document.createElement("div"); card.className = "sheep-card"; if (selected.includes(s.id)) card.classList.add("selected"); const info = levels[s.level]; if (s.level === 0) { const img = document.createElement("img"); img.src = SHEEP_IMAGE; img.alt = "گوسفند"; img.className = "sheep-image"; // اگر عکس پیدا نشد، ایموجی جایگزین می‌شود. img.onerror = function() { const emoji = document.createElement("div"); emoji.className = "sheep-emoji"; emoji.textContent = info.emoji; this.replaceWith(emoji); }; card.appendChild(img); } else { const emoji = document.createElement("div"); emoji.className = "sheep-emoji"; emoji.textContent = info.emoji; card.appendChild(emoji); } const label = document.createElement("div"); label.className = "level"; label.textContent = info.name + " | قدرت " + info.power; card.appendChild(label); card.addEventListener("click", () => { if (selected.includes(s.id)) { selected = selected.filter(id => id !== s.id); } else if (selected.length < 2) { selected.push(s.id); } else { selected = [s.id]; } drawGame(); message.textContent = selected.length === 2 ? "حالا دکمه ترکیب رو بزن! ✨" : "یک گوسفند دیگر انتخاب کن."; }); field.appendChild(card); }); if (sheep.length > 150) { const extra = document.createElement("p"); extra.textContent = (sheep.length - 150) + " گوسفند دیگر هم داری!"; field.appendChild(extra); } countText.textContent = sheep.length; powerText.textContent = getPower(); saveGame(); } function hitGround() { sheep.push({ id: Date.now() + Math.random(), level: 0 }); message.textContent = "یک گوسفند جدید به امپراتوری اضافه شد! 🐑"; drawGame(); } function mergeSheep() { if (selected.length !== 2) { message.textContent = "اول دو گوسفند انتخاب کن!"; return; } const first = sheep.find(s => s.id === selected[0]); const second = sheep.find(s => s.id === selected[1]); if (!first || !second) return; if (first.level !== second.level) { message.textContent = "فقط دو گوسفند هم‌سطح ترکیب می‌شن!"; return; } if (first.level >= levels.length - 1) { message.textContent = "این گوسفند به بالاترین سطح رسیده! 🌌"; return; } const newLevel = first.level + 1; sheep = sheep.filter(s => s.id !== first.id && s.id !== second.id ); sheep.push({ id: Date.now() + Math.random(), level: newLevel }); selected = []; message.textContent = "تبریک! یک گوسفند " + levels[newLevel].name + " ساختی! 🎉"; drawGame(); } function resetGame() { if (confirm("مطمئنی می‌خوای همه گوسفندها رو پاک کنی؟")) { sheep = []; selected = []; message.textContent = "امپراتوری از نو شروع شد!"; drawGame(); } } document.getElementById("hitButton").addEventListener("click", hitGround); document.getElementById("mergeButton").addEventListener("click", mergeSheep); document.getElementById("resetButton").addEventListener("click", resetGame); drawGame(); </script> </body> </html> 
